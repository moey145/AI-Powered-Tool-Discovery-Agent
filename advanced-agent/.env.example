# Copy to .env and fill in. Never commit .env.

# Required
OPENAI_API_KEY=

# Model used for extraction, analysis and recommendations
# OPENAI_MODEL=

# Search: set at least one key for reliable results.
# Without a key the agent falls back to DuckDuckGo's HTML page, which rate-limits heavily.
BRAVE_SEARCH_API_KEY=

# Google's Custom Search JSON API is discontinued on 2027-01-01.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# auto | brave | google_custom_search | duckduckgo
# SEARCH_PROVIDER=auto

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Abuse limits (per server instance)
# RATE_LIMIT_PER_MINUTE=5
# DAILY_SEARCH_BUDGET=200
